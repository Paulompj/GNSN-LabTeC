  GUARDA ||--o{ PADRINHO_GUARDA : "guarda"
  GUARDA ||--o{ PADRINHO_GUARDA : "padrinho"
  GUARDA ||--o{ FREQUENCIA : "one_to_many"
  GUARDA ||--o{ EMPRESTIMO : "one_to_many"
  GUARDA ||--o{ CAMISA : "one_to_many"
  GUARDA ||--o{ CAMISA : "one_to_many"
  GUARDA ||--o{ CAMISA_LOG : "one_to_many"
  GUARDA ||--o{ GUARDA_STATUS : "one_to_many"
