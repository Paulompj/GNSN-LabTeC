  LOCAL ||--o{ EVENTO : "one_to_many"

  CIRIO ||--o{ REGRA_CIRIO : "one_to_many"
  CATEGORIA_CIRIO ||--o{ REGRA_CIRIO : "one_to_many"

  CATEGORIA_MATERIAL ||--o{ MATERIAL : "one_to_many"
  SETOR ||--o{ MATERIAL : "one_to_many"
  MATERIAL ||--o{ ESTOQUE : "one_to_many"
  MATERIAL ||--o{ EMPRESTIMO : "one_to_many"

  EQUIPE ||--o{ CAMISA : "one_to_many"
  CAMISA ||--o{ CAMISA_LOG : "one_to_many"
  USUARIO ||--o{ CAMISA_LOG : "one_to_many"
